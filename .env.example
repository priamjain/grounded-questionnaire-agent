APP_USERNAME=admin
APP_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...

# Optional. Resend's shared sender only delivers to the Resend account owner's
# address; set this to an address on a domain verified at resend.com/domains
# to send to real recipients.
MAIL_FROM=Grounded <onboarding@resend.dev>

# Optional. Renders JavaScript-only pages (Notion, etc.) when the direct fetch
# finds no text. Works without a key at a lower rate limit; set READER_URL=""
# to disable rendering entirely.
READER_API_KEY=
READER_URL=https://r.jina.ai/
